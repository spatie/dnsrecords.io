{
    "name": "spatie/dnsrecords.io",
    "description": "DNS record lookups just as you like 'em.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.5",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-flare": "^3.6",
        "spatie/laravel-googletagmanager": "^3.1",
        "spatie/laravel-http-logger": "^1.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
